
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VIGERITH Security Event v0.2",
  "description": "Structural contract for synthetic security events.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "event_name",
    "event_type",
    "event_description",
    "source",
    "severity",
    "observed_at",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "event_name": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "event_type":{
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "event_description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": ".*\\S.*"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "severity": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
      "pattern": ".*\\S.*"
    },
      "uniqueItems": true
    }
  }
}
